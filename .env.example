# ==============================================================================
# Limiance Frontend - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend & API Configuration
# ------------------------------------------------------------------------------
# Client-facing API Base URL (used in axios client)
# Example: https://api.yourdomain.com/api/v1 or http://localhost:8080/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# WebSocket URL for real-time market feeds, order books, and portfolio updates
# Example: wss://api.yourdomain.com/api/v1/ws or ws://localhost:8080/api/v1/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws

# ------------------------------------------------------------------------------
# Google OAuth Configuration
# ------------------------------------------------------------------------------
# Client ID for Google OAuth sign-in (@react-oauth/google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Captcha Services
# ------------------------------------------------------------------------------
# Google reCAPTCHA v3 site key (public)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Google reCAPTCHA secret key (server-side token verification)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# GeeTest Captcha ID (v4)
NEXT_PUBLIC_GEETEST_CAPTCHA_ID=your_geetest_captcha_id

# ------------------------------------------------------------------------------
# Firebase & Cloud Messaging (FCM) Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id

# Firebase Web Push VAPID key for push notification subscriptions
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_firebase_vapid_key
